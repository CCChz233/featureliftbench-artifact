      "pendulum.duration.Duration",
      "pendulum.datetime.DateTime.format"
    ],
    "included_behaviors": [
      "parse ISO8601 dates, datetimes with Z or numeric offsets, and durations",
      "parse common YYYY-MM-DD and HH:mm:ss combinations",
      "construct DateTime and Duration instances",
      "format datetimes with Pendulum tokens (YYYY, MM, DD, HH, mm, ss, Z)",
      "duration component properties (years, months, weeks, days, hours, minutes, seconds)"
    ],
    "excluded_behaviors": [
      "bundled tzdata or IANA timezone database traversal",
