{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureLiftBench closure gold v1.1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "closure_variants",
    "gold_completeness",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "featureliftbench.closure_gold.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "entrypoints": { "type": "array", "items": { "type": "string" } },
    "closure_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variant_id", "requirements"],
        "properties": {
          "variant_id": { "type": "string", "minLength": 1 },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["requirement_id", "kind", "necessity", "satisfied_by"],
              "properties": {
                "requirement_id": { "type": "string", "minLength": 1 },
                "kind": {
                  "enum": ["file", "symbol", "resource", "runtime_state", "third_party", "adapter"]
                },
                "necessity": { "enum": ["must", "optional"] },
                "satisfied_by": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "anyOf": [
                      { "type": "string", "minLength": 1 },
                      {
                        "type": "object",
                        "required": ["solution_id", "artifacts"],
                        "properties": {
                          "solution_id": { "type": "string", "minLength": 1 },
                          "artifacts": { "type": "array", "minItems": 1 }
                        }
                      }
                    ]
                  }
                },
                "behavior_ids": { "type": "array", "items": { "type": "string" } },
                "evidence_paths": { "type": "array", "items": { "type": "string" } },
                "rationale": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "gold_completeness": {
      "anyOf": [
        { "enum": ["complete", "partial", "unresolved"] },
        {
          "type": "object",
          "additionalProperties": { "enum": ["complete", "partial", "unresolved"] }
        }
      ]
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "auto_assigned", "ai_assisted_reviewed", "author_reviewed",
            "double_reviewed", "adjudicated", "needs_review"
          ]
        }
      }
    }
  }
}
