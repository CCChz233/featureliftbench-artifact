{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featureliftbench.local/schemas/repo_graph_claim.schema.json",
  "title": "FeatureLiftBench Repository Graph Claim Event",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "subject",
    "predicate",
    "classification",
    "status",
    "evidence_ids",
    "submission_revision",
    "snapshot_id",
    "environment_scope_hash"
  ],
  "properties": {
    "schema_version": {"const": "featureliftbench.repo_graph.claim.v1"},
    "claim_id": {"type": "string", "pattern": "^claim_[0-9]{4,}$"},
    "subject": {"type": "string"},
    "predicate": {"type": "string"},
    "object": {"type": "string"},
    "classification": {
      "enum": ["required", "replaceable", "incidental", "optional", "unresolved", "excluded"]
    },
    "status": {"enum": ["hypothesis", "observed", "verified", "contradicted", "stale"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "submission_revision": {"type": "integer", "minimum": 0},
    "snapshot_id": {"type": "string"},
    "environment_scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
